{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "model_required",
    "input",
    "faults",
    "expected_invariants"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^S[0-9]{2}_[A-Z0-9_]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "model_required": {
      "type": "boolean"
    },
    "input": {
      "type": "object"
    },
    "faults": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "expected_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
