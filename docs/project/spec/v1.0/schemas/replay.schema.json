{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "replay.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "mode",
    "source_git_sha",
    "eval_receipt_digest",
    "events",
    "final_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "recorded_acceptance_replay"
    },
    "source_git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "eval_receipt_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "seq",
          "type",
          "summary"
        ],
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "final_status": {
      "enum": [
        "COMPLETED",
        "REJECTED",
        "FAILED",
        "BUDGET_EXCEEDED",
        "CANCELLED"
      ]
    }
  }
}
