{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acceptance_receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "git_sha",
    "scenario_set_digest",
    "lockfile_digests",
    "gates",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "scenario_set_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lockfile_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "PASS",
          "FAIL",
          "NOT_RUN",
          "NOT_APPLICABLE"
        ]
      }
    },
    "created_at": {
      "type": "string"
    }
  }
}
